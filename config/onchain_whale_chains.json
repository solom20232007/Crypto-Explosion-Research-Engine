{
  "version": "onchain-whale-v1",
  "chains": [
    {"chain": "ethereum", "family": "evm", "chain_id": 1, "enabled": true},
    {"chain": "bsc", "family": "evm", "chain_id": 56, "enabled": true},
    {"chain": "solana", "family": "solana", "cluster": "mainnet-beta", "enabled": true}
  ],
  "thresholds": {
    "default_min_transfer_usd": 100000,
    "stablecoin_symbols": ["USDT", "USDC", "DAI", "FDUSD", "USDE"],
    "min_label_confidence": 0.8
  },
  "collection": {
    "mode": "research_only",
    "store_raw_payload": true,
    "require_observed_at": true,
    "do_not_infer_trade_direction_from_transfer": true
  },
  "providers": {
    "evm_global_transfers": null,
    "solana_global_transfers": null,
    "wallet_history": null
  }
}
